# Database - Neon pooled URL for application traffic
DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Database - direct URL for Prisma migrations and administrative operations
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon Auth
NEON_AUTH_BASE_URL="https://ENDPOINT.neonauth.REGION.aws.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET="replace-with-at-least-32-random-characters"

# Payments
PAYSTACK_SECRET_KEY="sk_test_replace-me"
PAYSTACK_PUBLIC_KEY="pk_test_replace-me"

# Application
APP_URL="http://localhost:3000"
CRON_SECRET="replace-with-a-random-reconciliation-secret"

# Foreign exchange provider
FX_API_BASE_URL="https://api.example.com"
FX_API_KEY="replace-me"
