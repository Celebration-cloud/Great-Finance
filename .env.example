# Database - Neon pooled URL for application traffic
DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Database - direct URL for Prisma migrations and administrative operations
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon Auth
NEON_AUTH_BASE_URL="https://ENDPOINT.neonauth.REGION.aws.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET="replace-with-at-least-32-random-characters"

# Unified Neon Auth + Data API browser client (contains no database password)
NEXT_PUBLIC_NEON_DATABASE_URL="https://ENDPOINT.REGION.aws.neon.tech/neondb"
NEON_DATA_API_URL="https://ENDPOINT.apirest.REGION.aws.neon.tech/neondb/rest/v1"

# Private Neon Object Storage (server-side only)
NEON_STORAGE_BUCKET="document"
AWS_ACCESS_KEY_ID="replace-with-branch-credential-token-id"
AWS_SECRET_ACCESS_KEY="replace-with-branch-storage-secret"
AWS_ENDPOINT_URL_S3="https://BRANCH.storage.REGION.aws.neon.tech"
AWS_REGION="us-east-1"

# Private Vercel Blob store for KYC images (created/connected in Vercel Storage)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_replace-me"

# Payments
PAYSTACK_SECRET_KEY="sk_test_replace-me"
PAYSTACK_PUBLIC_KEY="pk_test_replace-me"

# Application
APP_URL="http://localhost:3000"
CRON_SECRET="replace-with-a-random-reconciliation-secret"

# Foreign exchange provider (optional override; no API key required)
FX_API_BASE_URL="https://open.er-api.com/v6/"
