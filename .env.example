# Neon runtime traffic uses the pooled URL; migrations use the direct URL.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/database?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/database?sslmode=require"

# Provision Neon Auth for the project, then copy its endpoint and generate a 32+ character secret.
NEON_AUTH_BASE_URL="https://your-neon-auth-endpoint"
NEON_AUTH_COOKIE_SECRET="replace-with-at-least-32-random-characters"

PAYSTACK_SECRET_KEY="sk_test_replace_me"
PAYSTACK_PUBLIC_KEY="pk_test_replace_me"
APP_URL="http://localhost:3000"
CRON_SECRET="replace-with-a-random-reconciliation-secret"

# Use a production FX provider; its API key remains server-side.
FX_API_BASE_URL="https://api.example.com/v1"
FX_API_KEY="replace-with-provider-key"

# Legacy Vite/Firebase client. Retained while the old src/ application remains in the repository.
VITE_FIREBASE_API_KEY="replace-with-firebase-web-api-key"
VITE_FIREBASE_AUTH_DOMAIN="replace-with-firebase-auth-domain"
VITE_FIREBASE_PROJECT_ID="replace-with-firebase-project-id"
VITE_FIREBASE_STORAGE_BUCKET="replace-with-firebase-storage-bucket"
VITE_FIREBASE_MESSAGING_SENDER_ID="replace-with-firebase-messaging-sender-id"
VITE_FIREBASE_APP_ID="replace-with-firebase-app-id"
